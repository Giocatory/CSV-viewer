<Window x:Class="CsvViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CsvViewer.Converters"
        Title="CSV/XLSX Viewer — Редактор таблиц" 
        Height="650" Width="950"
        MinWidth="650" MinHeight="450">

    <Window.Resources>
        <converters:DelimiterConverter x:Key="DelimiterConverter"/>
        <converters:RowIndexConverter x:Key="RowIndexConverter"/>
        <converters:CellStyleConverter x:Key="CellStyleConverter"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="160"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="4,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для изменённых ячеек -->
        <Style x:Key="ModifiedCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content, Converter={StaticResource CellStyleConverter}}"/>
            <Setter Property="ToolTip" Value="Изменено"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Открыть файл" Command="{Binding OpenCommand}" 
                    ToolTip="Поддержка CSV и XLSX форматов"/>

            <Label Content="Разделитель (CSV):"/>
            <ComboBox ItemsSource="{Binding AvailableDelimiters}" 
                      SelectedItem="{Binding SelectedDelimiter, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource DelimiterConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" 
                       Margin="8,0" Width="1" Background="#AAA"/>

            <Label Content="Поиск:"/>
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                     ToolTip="Поиск по всем столбцам (регистр не учитывается)"/>
            <Button Content="Найти" Command="{Binding FilterCommand}"/>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" 
                       Margin="8,0" Width="1" Background="#AAA"/>

            <Button Content="Экспорт JSON" Command="{Binding ExportJsonCommand}"
                    ToolTip="Экспорт в JSON (только просмотр)"/>
            <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}"
                    ToolTip="Экспорт в CSV с текущими изменениями"/>
        </StackPanel>

        <!-- Статус -->
        <TextBlock Grid.Row="1" 
                   Text="{Binding StatusText}" 
                   Foreground="#555" 
                   FontStyle="Italic"
                   Margin="0,0,0,8"/>

        <!-- Таблица данных -->
        <DataGrid x:Name="dataGrid"
                  Grid.Row="2" 
                  ItemsSource="{Binding DataView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="CellOrRowHeader"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  RowDetailsVisibilityMode="Collapsed"
                  Background="White"
                  BorderBrush="#DDD"
                  BorderThickness="1"
                  CellStyle="{StaticResource ModifiedCellStyle}"
                  BeginningEdit="DataGrid_BeginningEdit"
                  CellEditEnding="DataGrid_CellEditEnding">

            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Width="40" IsReadOnly="True" CanUserSort="False">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource RowIndexConverter}">
                            <Binding RelativeSource="{RelativeSource FindAncestor, AncestorType=DataGrid}"/>
                            <Binding />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>